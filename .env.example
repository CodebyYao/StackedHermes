# =============================================================================
# Hermes stack configuration.
#
#   cp .env.example .env    then edit .env and fill in every CHANGE ME below.
#   chmod 600 .env
#
# .env is gitignored. Never commit it — it holds passwords and API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the stack refuses to start until these are set
# -----------------------------------------------------------------------------

# Root password for SSH into the agent container.  <<< CHANGE ME >>>
# Generate a strong one:  openssl rand -base64 24 | tr -d '/+=' | head -c 28
SSH_PASSWORD=

# Camofox browser server keys.  <<< CHANGE ME >>>
# Generate each:  openssl rand -hex 32
CAMOFOX_API_KEY=
CAMOFOX_ADMIN_KEY=

# Password for the Camofox noVNC live-view.  <<< CHANGE ME >>>
VNC_PASSWORD=

# -----------------------------------------------------------------------------
# SSH exposure
# -----------------------------------------------------------------------------
# Host port forwarded to the container's sshd. Pick any free port.
SSH_PORT=22022

# 127.0.0.1 = reachable only from this machine (default, safest).
# 0.0.0.0    = reachable from your LAN, and from the internet if you port-forward
#              at your router. Read the SECURITY section of the README first —
#              switch to key-based auth before doing this.
SSH_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# Lifecycle
# -----------------------------------------------------------------------------
# "no"             = containers never restart on their own (default)
# "unless-stopped" = containers come back after a reboot or docker restart
RESTART_POLICY=no

# -----------------------------------------------------------------------------
# GPU / model sizing
# -----------------------------------------------------------------------------
# Number of GPUs to pass through: "all" (default), an integer like 1 or 2,
# or 0 for CPU-only. Works on any GPU count without further edits.
GPU_COUNT=all

# CUDA base image for the agent container. MUST be supported by your driver:
#   CUDA 12.x -> driver >= 525      CUDA 13.x -> driver >= 580
# Check with `nvidia-smi`.
CUDA_IMAGE=nvidia/cuda:12.6.3-devel-ubuntu24.04

# 0 = pack a model onto as few GPUs as possible (correct for a single GPU, and
#     faster whenever the model fits on one card)
# 1 = spread every model across all GPUs (needed when a model is too big to fit
#     on one card, e.g. a 27B at long context on 2x24 GB)
OLLAMA_SCHED_SPREAD=0

# Models kept resident in VRAM. Raise only if you have room for both.
OLLAMA_MAX_LOADED_MODELS=1

# Unload an idle model after this long.
OLLAMA_KEEP_ALIVE=15m

# Flash attention: 1 on Ampere (RTX 30xx/A100) or newer, 0 on Turing (RTX 20xx)
# and older. Large KV-cache saving at long context.
OLLAMA_FLASH_ATTENTION=1

# -----------------------------------------------------------------------------
# Host ports (all bound to 127.0.0.1 — change only on a conflict)
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434
CAMOFOX_PORT=9377
NOVNC_PORT=6080
PORTAINER_PORT=9443

# -----------------------------------------------------------------------------
# Docker networks
# -----------------------------------------------------------------------------
# Change these only if they collide with an existing subnet on your machine.
# If you do change HERMES_SUBNET/GATEWAY, re-run install-prereqs.sh so the
# host-isolation firewall rule is rewritten to match.
HERMES_SUBNET=172.28.0.0/16
HERMES_GATEWAY=172.28.0.1
MGMT_SUBNET=172.29.0.0/16
MGMT_GATEWAY=172.29.0.1

# -----------------------------------------------------------------------------
# Resource caps
# -----------------------------------------------------------------------------
# Keep AGENT_MEM_LIMIT below your total system RAM.
AGENT_MEM_LIMIT=16g
AGENT_PIDS_LIMIT=4096
CAMOFOX_SHM_SIZE=2gb
CAMOFOX_HEAP_MB=512
CAMOFOX_ENABLE_VNC=1
